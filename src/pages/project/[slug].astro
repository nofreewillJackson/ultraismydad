---
import { getWorkItemPaths } from "../../app/work-item-pages";
import { FilesystemWorkItemStore } from "../../store/filesystem-work-item-store";

// Thin glue: the framework boundary calls our tested use case. No business
// logic lives here — which items become pages is decided by the export
// (privacy gate), the URL key is the item's slug, and the HTML is produced by
// the render function. The [slug] filename binds to params.slug returned by
// getWorkItemPaths.
//
// The data source is the single filesystem snapshot for this environment
// (one source, no fallback cascade). It contains every item — public AND
// private — and the export's privacy gate is what omits the private ones.
export async function getStaticPaths() {
  return getWorkItemPaths(new FilesystemWorkItemStore("data/work-items.json"));
}

const { html } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Project</title>
  </head>
  <body set:html={html}></body>
</html>
